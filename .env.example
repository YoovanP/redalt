# Browser-visible configuration. Keep the frontend on one same-origin gateway.
VITE_REDDIT_API_BASES=/api/reddit

# Server-only Reddit API configuration. Never prefix these with VITE_.
# Create an OAuth application at https://www.reddit.com/prefs/apps and configure
# the values in your Vercel, Cloudflare Pages, or Render environment.
REDDIT_PROXY_USER_AGENT=web:RedAlt:0.2.0 (public read-only client)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Optional: use a refresh token for user-authorized access instead of app-only access.
REDDIT_REFRESH_TOKEN=
# Optional development override for a short-lived bearer token. Prefer client credentials.
REDDIT_OAUTH_ACCESS_TOKEN=

# Degraded fallbacks are off by default: they are slower and public instances may
# be blocked or return incomplete media. Enable only after deliberately operating them.
ENABLE_PUBLIC_INSTANCE_FALLBACK=false
ENABLE_PUBLIC_INSTANCE_DISCOVERY=false
REDDIT_PUBLIC_INSTANCE_BASES=
ENABLE_MIRROR_FALLBACK=false
ENABLE_LEGACY_SCRAPE_FALLBACK=false
