{
  "name": "redalt",
  "private": true,
  "version": "0.1.0",
  "description": "Reddit alternate frontend powered by Reddit JSON endpoints",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:components": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:components && npm run test:e2e"
  },
  "keywords": [
    "reddit",
    "frontend",
    "vite"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "hls.js": "^1.6.16",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
